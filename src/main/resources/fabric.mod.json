{
  "schemaVersion": 1,
  "id": "morestoragestack",
  "version": "${version}",
  "name": "MoreStorageStack",
  "description": "Customizable stack size modifier. Items below the configured limit are raised; items at or above keep their vanilla limit. Unstackable items stay unstackable.",
  "authors": [
    "Ruinerpie"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/morestoragestack"
  },
  "license": "All Rights Reserved",
  "icon": "assets/morestoragestack/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ruinerpie.morestoragestack.MoreStorageStackMod"
    ],
    "client": [
      "com.ruinerpie.morestoragestack.client.MoreStorageStackClient"
    ],
    "modmenu": [
      "com.ruinerpie.morestoragestack.client.MoreStorageStackModMenu"
    ]
  },
  "mixins": [
    "morestoragestack.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~26.1.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
